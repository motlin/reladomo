<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.goldmansachs.reladomo</groupId>
        <artifactId>reladomo-parent</artifactId>
        <version>18.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>reladomo-test-onheap</artifactId>

    <name>Reladomo Tests (On-Heap)</name>
    <description>Reladomo on-heap test suite. Generates on-heap domain classes and compiles hand-written tests against them.</description>

    <dependencies>
        <dependency>
            <groupId>com.goldmansachs.reladomo</groupId>
            <artifactId>reladomo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.goldmansachs.reladomo</groupId>
            <artifactId>reladomo-test-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.goldmansachs.reladomo</groupId>
            <artifactId>reladomogen</artifactId>
        </dependency>
        <dependency>
            <groupId>com.goldmansachs.reladomo</groupId>
            <artifactId>reladomo-test-resources</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-junit</artifactId>
            <version>${ant.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derby</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbynet</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mortbay.jetty</groupId>
            <artifactId>jetty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mortbay.jetty</groupId>
            <artifactId>jetty-util</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
        </dependency>
        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
        </dependency>
        <dependency>
            <groupId>mockobjects</groupId>
            <artifactId>mockobjects-core</artifactId>
        </dependency>
        <dependency>
            <groupId>mockobjects</groupId>
            <artifactId>mockobjects-jdk1.4</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.geronimo.specs</groupId>
            <artifactId>geronimo-jms_1.1_spec</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Step 1: Unpack hand-written test Java files and XML definitions
                from reladomo-test-resources into the build directory.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-test-resources</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.goldmansachs.reladomo</groupId>
                                    <artifactId>reladomo-test-resources</artifactId>
                                    <version>${project.version}</version>
                                    <outputDirectory>${project.build.directory}/unpacked</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Step 2: Generate on-heap Reladomo classes from XML definitions.
                Runs the generator 4 times matching the Ant build.
            -->
            <plugin>
                <groupId>com.goldmansachs.reladomo</groupId>
                <artifactId>reladomo-gen-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-import-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <xml>${project.build.directory}/unpacked/test-reladomo-xml/MithraClassListToImport.xml</xml>
                            <generatedDir>${project.build.directory}/generated-sources/reladomo</generatedDir>
                            <nonGeneratedDir>${project.build.directory}/unpacked/test-java</nonGeneratedDir>
                            <generateEcListMethod>true</generateEcListMethod>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-main-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <xml>${project.build.directory}/unpacked/test-reladomo-xml/MithraClassList.xml</xml>
                            <generatedDir>${project.build.directory}/generated-sources/reladomo</generatedDir>
                            <nonGeneratedDir>${project.build.directory}/unpacked/test-java</nonGeneratedDir>
                            <generateEcListMethod>true</generateEcListMethod>
                            <mithraImports>
                                <mithraImport>
                                    <dir>${project.build.directory}/unpacked/test-reladomo-xml</dir>
                                    <filename>MithraClassListToImport.xml</filename>
                                </mithraImport>
                                <mithraImport>
                                    <dir>${project.build.directory}/unpacked/test-reladomo-xml/testmithraimport</dir>
                                    <filename>MithraTestImportClassList.xml</filename>
                                </mithraImport>
                            </mithraImports>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-test-import-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <xml>${project.build.directory}/unpacked/test-reladomo-xml/testmithraimport/MithraTestImportClassList.xml</xml>
                            <generatedDir>${project.build.directory}/generated-sources/reladomo</generatedDir>
                            <nonGeneratedDir>${project.build.directory}/unpacked/test-java</nonGeneratedDir>
                            <mithraImports>
                                <mithraImport>
                                    <dir>${project.build.directory}/unpacked/test-reladomo-xml</dir>
                                    <filename>MithraClassList.xml</filename>
                                </mithraImport>
                                <mithraImport>
                                    <dir>${project.build.directory}/unpacked/test-reladomo-xml</dir>
                                    <filename>MithraClassListToImport.xml</filename>
                                </mithraImport>
                            </mithraImports>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-final-getter-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <xml>${project.build.directory}/unpacked/test-reladomo-xml/finalgetter/MithraFinalGetterClassList.xml</xml>
                            <generatedDir>${project.build.directory}/generated-sources/reladomo</generatedDir>
                            <nonGeneratedDir>${project.build.directory}/unpacked/test-java</nonGeneratedDir>
                            <generateEcListMethod>true</generateEcListMethod>
                            <defaultFinalGetters>true</defaultFinalGetters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Step 3: Add the unpacked hand-written test sources and generated sources
                as compile source roots.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-test-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/unpacked/test-java</source>
                                <source>${project.build.directory}/generated-sources/reladomo</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-test-resources</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/unpacked/test-resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:-unchecked</arg>
                        <arg>-Xlint:-deprecation</arg>
                    </compilerArgs>
                    <excludes>
                        <exclude>com/gs/fw/common/mithra/test/offheap/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
                    <argLine>-server -Xmx3048m -ea -Duser.timezone=America/New_York</argLine>
                    <reuseForks>false</reuseForks>
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <useSystemClassLoader>true</useSystemClassLoader>
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                    <systemPropertyVariables>
                        <mithra.xml.root>${project.build.outputDirectory}/</mithra.xml.root>
                        <log4j.configuration>file:${project.build.outputDirectory}/log4jWarn.config</log4j.configuration>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <!-- Suite 2: Full cache, MithraTestSuite (default) -->
                    <execution>
                        <id>default-test</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite2}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraConfigFullCache.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/MithraTestSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Suite 1: Partial cache, MithraTestSuite -->
                    <execution>
                        <id>suite1</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite1}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraConfigPartialCache.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/MithraTestSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Suite 3: Partial cache, MithraMultiVmTestSuite -->
                    <execution>
                        <id>suite3</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite3}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraConfigPartialCache.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/MithraMultiVmTestSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Suite 4: Full cache, MithraMultiVmTestSuite -->
                    <execution>
                        <id>suite4</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite4}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraConfigFullCache.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/MithraMultiVmTestSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Suite 7: Util tests -->
                    <execution>
                        <id>suite7</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite7}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>Util.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/MithraUtilTestSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Suite 9 onheap parts -->
                    <execution>
                        <id>suite9-cacheloader</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite9}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraCacheTestConfig.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/CacheLoaderSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>suite9-tostring</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite9}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraConfigPartialCache.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/MithraToStringTestSuite.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>suite9-tablemanager</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skipTests>${skip.suite9}</skipTests>
                            <systemPropertyVariables>
                                <mithra.xml.config>MithraTestTableManagerConfig.xml</mithra.xml.config>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/TestTablePartitionManager.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Default: only suite2 (FullCache/MithraTestSuite) runs -->
        <profile>
            <id>default-suites</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <skip.suite1>true</skip.suite1>
                <skip.suite2>false</skip.suite2>
                <skip.suite3>true</skip.suite3>
                <skip.suite4>true</skip.suite4>
                <skip.suite7>true</skip.suite7>
                <skip.suite9>true</skip.suite9>
            </properties>
        </profile>
        <!-- All onheap suites -->
        <profile>
            <id>all-suites</id>
            <properties>
                <skip.suite1>false</skip.suite1>
                <skip.suite2>false</skip.suite2>
                <skip.suite3>false</skip.suite3>
                <skip.suite4>false</skip.suite4>
                <skip.suite7>false</skip.suite7>
                <skip.suite9>false</skip.suite9>
            </properties>
        </profile>
        <!-- Individual suites for CI parallelization -->
        <profile>
            <id>suite1</id>
            <properties>
                <skip.suite1>false</skip.suite1>
                <skip.suite2>true</skip.suite2>
                <skip.suite3>true</skip.suite3>
                <skip.suite4>true</skip.suite4>
                <skip.suite7>true</skip.suite7>
                <skip.suite9>true</skip.suite9>
            </properties>
        </profile>
        <profile>
            <id>suite2</id>
            <properties>
                <skip.suite1>true</skip.suite1>
                <skip.suite2>false</skip.suite2>
                <skip.suite3>true</skip.suite3>
                <skip.suite4>true</skip.suite4>
                <skip.suite7>true</skip.suite7>
                <skip.suite9>true</skip.suite9>
            </properties>
        </profile>
        <profile>
            <id>suite3</id>
            <properties>
                <skip.suite1>true</skip.suite1>
                <skip.suite2>true</skip.suite2>
                <skip.suite3>false</skip.suite3>
                <skip.suite4>true</skip.suite4>
                <skip.suite7>true</skip.suite7>
                <skip.suite9>true</skip.suite9>
            </properties>
        </profile>
        <profile>
            <id>suite4</id>
            <properties>
                <skip.suite1>true</skip.suite1>
                <skip.suite2>true</skip.suite2>
                <skip.suite3>true</skip.suite3>
                <skip.suite4>false</skip.suite4>
                <skip.suite7>true</skip.suite7>
                <skip.suite9>true</skip.suite9>
            </properties>
        </profile>
        <profile>
            <id>suite7</id>
            <properties>
                <skip.suite1>true</skip.suite1>
                <skip.suite2>true</skip.suite2>
                <skip.suite3>true</skip.suite3>
                <skip.suite4>true</skip.suite4>
                <skip.suite7>false</skip.suite7>
                <skip.suite9>true</skip.suite9>
            </properties>
        </profile>
        <profile>
            <id>suite9</id>
            <properties>
                <skip.suite1>true</skip.suite1>
                <skip.suite2>true</skip.suite2>
                <skip.suite3>true</skip.suite3>
                <skip.suite4>true</skip.suite4>
                <skip.suite7>true</skip.suite7>
                <skip.suite9>false</skip.suite9>
            </properties>
        </profile>
    </profiles>
</project>
